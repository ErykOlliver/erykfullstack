generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SkillCategory {
  SOFT
  HARD
}

enum ProjectCategory {
  FULLSTACK
  FRONTEND
  BACKEND
  MOBILE
  GAME
  API
}

enum Status {
  EM_ANDAMENTO
  FINALIZADO
}

model Skill {
  id       Int           @id @unique @default(autoincrement())
  name     String        @unique
  category SkillCategory
  projects Project[]     @relation("ProjectSkills")
}

model Admin {
  id        Int      @id @unique @default(autoincrement())
  admin     String   @unique
  key       String
  createdAt DateTime @default(now())
}

model Project {
  id              String          @id @unique @default(uuid())
  poster          String
  title           String
  description     String
  slug            String          @unique
  github          String?
  page            String?
  status          Status          @default(EM_ANDAMENTO)
  designer        String
  designerPage    String
  applicationType String
  isFeatured      Boolean?        @default(false)
  category        ProjectCategory @default(FRONTEND)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  skills          Skill[]         @relation("ProjectSkills")
}

model Network {
  id   Int    @id @unique @default(autoincrement())
  name String @unique
  link String @unique
}

model TradeIn {
  id String @id @default(uuid())
  clientName String
  valuation Float
  generatedLink String
  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
}